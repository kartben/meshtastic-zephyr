# SPDX-License-Identifier: GPL-3.0

config MESHTASTIC_SAMPLE_FREQUENCY
	int "LoRa carrier frequency (Hz)"
	default 0
	help
	  Carrier frequency in Hz, e.g. 906875000 for the default US
	  LongFast slot or 913125000 for US MediumFast slot 45.
	  0 selects the EU LongFast default (869.525 MHz).

config MESHTASTIC_SAMPLE_SPREAD_FACTOR
	int "LoRa spreading factor"
	range 0 12
	default 0
	help
	  Spreading factor 7-12. Together with the fixed BW 250 kHz this
	  selects the Meshtastic modem preset (11 = LongFast,
	  9 = MediumFast). 0 selects the stack default (SF 11).

config MESHTASTIC_SAMPLE_DEMO_BROADCAST
	bool "Periodically broadcast a demo text message"
	default y
	help
	  Broadcast "Hello from <board>!" on the primary channel at the
	  interval below. Handy as a first-contact smoke test; disable it
	  when the sample is used as day-to-day firmware on a real mesh.

config MESHTASTIC_SAMPLE_DEMO_BROADCAST_INTERVAL_SEC
	int "Demo broadcast interval (seconds)"
	depends on MESHTASTIC_SAMPLE_DEMO_BROADCAST
	default 300

source "Kconfig.zephyr"
